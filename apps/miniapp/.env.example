# Copy to .env.development.local (gitignored) to override the LAN API address.
# vite-plugin-taro reads VITE_* plus the TARO_APP_* prefix configured in vite.config.ts.
VITE_VPT_WECHAT_APP_ID=touristappid
TARO_APP_TRANSPORT=http
TARO_APP_API_BASE_URL=http://127.0.0.1:8000/api/v1
TARO_APP_CLOUD_ENV=
TARO_APP_CLOUD_SERVICE=tennis-api
TARO_APP_ENV=dev
